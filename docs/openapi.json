{
  "openapi": "3.1.0",
  "info": {
    "title": "BedFlow Chile API",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/simulate": {
      "post": {
        "summary": "Simulate Endpoint",
        "operationId": "simulate_endpoint_api_v1_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/compare": {
      "post": {
        "summary": "Compare Endpoint",
        "operationId": "compare_endpoint_api_v1_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompareRequest": {
        "properties": {
          "base_config": {
            "$ref": "#/components/schemas/SimulationConfig"
          },
          "seeds": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 2,
            "title": "Seeds"
          },
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/ScenarioVariant"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Scenarios"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_config",
          "seeds",
          "scenarios"
        ],
        "title": "CompareRequest"
      },
      "CompareResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "seeds": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Seeds"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/CompareScenarioResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "seeds",
          "results"
        ],
        "title": "CompareResponse"
      },
      "CompareScenarioResult": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "summary": {
            "$ref": "#/components/schemas/CompareSummary"
          },
          "paired_delta_12h_pp": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetricStats"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenario_id",
          "label",
          "summary",
          "paired_delta_12h_pp"
        ],
        "title": "CompareScenarioResult"
      },
      "CompareSummary": {
        "properties": {
          "admitted_within_12h_pct": {
            "$ref": "#/components/schemas/MetricStats"
          },
          "mean_wait_to_bed_capped_12h_min": {
            "$ref": "#/components/schemas/MetricStats"
          },
          "avg_ed_bay_utilization_pct": {
            "$ref": "#/components/schemas/MetricStats"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "admitted_within_12h_pct",
          "mean_wait_to_bed_capped_12h_min",
          "avg_ed_bay_utilization_pct"
        ],
        "title": "CompareSummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetricStats": {
        "properties": {
          "mean": {
            "type": "number",
            "title": "Mean"
          },
          "ci95_low": {
            "type": "number",
            "title": "Ci95 Low"
          },
          "ci95_high": {
            "type": "number",
            "title": "Ci95 High"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mean",
          "ci95_low",
          "ci95_high"
        ],
        "title": "MetricStats"
      },
      "PatientExample": {
        "properties": {
          "patient_id": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Patient Id"
          },
          "admission_wait_min": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Admission Wait Min"
          },
          "milestones": {
            "items": {
              "$ref": "#/components/schemas/PatientMilestone"
            },
            "type": "array",
            "title": "Milestones"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "patient_id",
          "milestones"
        ],
        "title": "PatientExample"
      },
      "PatientMilestone": {
        "properties": {
          "minute": {
            "type": "number",
            "minimum": 0.0,
            "title": "Minute"
          },
          "type": {
            "type": "string",
            "enum": [
              "ED_ARRIVAL",
              "ED_BAY_ENTER",
              "PHYSICIAN_START",
              "PHYSICIAN_END",
              "ADMISSION_INDICATED",
              "WARD_ADMITTED",
              "ED_DISCHARGED",
              "WARD_DISCHARGED",
              "BED_READY"
            ],
            "title": "Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "minute",
          "type"
        ],
        "title": "PatientMilestone"
      },
      "ScenarioVariant": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "enum": [
              "baseline",
              "more_physicians",
              "faster_turnover",
              "more_ward_beds"
            ],
            "title": "Scenario Id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "title": "Label"
          },
          "overrides": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "type": "object",
            "title": "Overrides"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenario_id",
          "label",
          "overrides"
        ],
        "title": "ScenarioVariant"
      },
      "SimulateRequest": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1,
            "title": "Scenario Id"
          },
          "seed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Seed"
          },
          "config": {
            "$ref": "#/components/schemas/SimulationConfig"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenario_id",
          "seed",
          "config"
        ],
        "title": "SimulateRequest"
      },
      "SimulationConfig": {
        "properties": {
          "arrival_rate_per_hour": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Arrival Rate Per Hour"
          },
          "physicians": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Physicians"
          },
          "ed_spaces": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Ed Spaces"
          },
          "ward_beds": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Ward Beds"
          },
          "initial_ward_occupied": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Initial Ward Occupied"
          },
          "admission_probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Admission Probability"
          },
          "mean_physician_service_min": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Mean Physician Service Min"
          },
          "mean_inpatient_los_h": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Mean Inpatient Los H"
          },
          "bed_turnover_min": {
            "type": "number",
            "minimum": 0.0,
            "title": "Bed Turnover Min"
          },
          "warmup_h": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Warmup H"
          },
          "measurement_h": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Measurement H"
          },
          "followup_h": {
            "type": "integer",
            "minimum": 12.0,
            "title": "Followup H"
          },
          "snapshot_every_min": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Snapshot Every Min"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "arrival_rate_per_hour",
          "physicians",
          "ed_spaces",
          "ward_beds",
          "initial_ward_occupied",
          "admission_probability",
          "mean_physician_service_min",
          "mean_inpatient_los_h",
          "bed_turnover_min",
          "warmup_h",
          "measurement_h",
          "followup_h",
          "snapshot_every_min"
        ],
        "title": "SimulationConfig"
      },
      "SimulationMetrics": {
        "properties": {
          "eligible_admissions": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Eligible Admissions"
          },
          "admitted_within_12h_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Admitted Within 12H Count"
          },
          "admitted_within_12h_pct": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Admitted Within 12H Pct"
          },
          "mean_wait_to_bed_capped_12h_min": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 720.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Wait To Bed Capped 12H Min"
          },
          "p90_wait_to_bed_capped_12h_min": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 720.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "P90 Wait To Bed Capped 12H Min"
          },
          "avg_ed_bay_utilization_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Avg Ed Bay Utilization Pct"
          },
          "avg_ward_occupancy_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Avg Ward Occupancy Pct"
          },
          "max_ed_boarding": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Max Ed Boarding"
          },
          "ed_arrivals_measured": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Ed Arrivals Measured"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "eligible_admissions",
          "admitted_within_12h_count",
          "avg_ed_bay_utilization_pct",
          "avg_ward_occupancy_pct",
          "max_ed_boarding",
          "ed_arrivals_measured"
        ],
        "title": "SimulationMetrics"
      },
      "SimulationResult": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "seed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Seed"
          },
          "metrics": {
            "$ref": "#/components/schemas/SimulationMetrics"
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/TimelineSnapshot"
            },
            "type": "array",
            "title": "Timeline"
          },
          "patient_examples": {
            "items": {
              "$ref": "#/components/schemas/PatientExample"
            },
            "type": "array",
            "title": "Patient Examples"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenario_id",
          "seed",
          "metrics",
          "timeline",
          "patient_examples"
        ],
        "title": "SimulationResult"
      },
      "TimelineSnapshot": {
        "properties": {
          "minute": {
            "type": "number",
            "minimum": 0.0,
            "title": "Minute"
          },
          "ed_waiting": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Ed Waiting"
          },
          "ed_treatment": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Ed Treatment"
          },
          "ed_boarding": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Ed Boarding"
          },
          "ward_occupied": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Ward Occupied"
          },
          "ward_turnover": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Ward Turnover"
          },
          "ward_ready": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Ward Ready"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "minute",
          "ed_waiting",
          "ed_treatment",
          "ed_boarding",
          "ward_occupied",
          "ward_turnover",
          "ward_ready"
        ],
        "title": "TimelineSnapshot"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
